# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ===== LLM API keys =====
# Required for AI quiz generation and essay evaluation (Claude).
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: only needed if using the OpenAI-backed chat/agent tools.
OPENAI_API_KEY=

# ===== Server =====
FASTAPI_URL=http://localhost:8000
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# ===== Database (SQLite) =====
# DATABASE_PATH=data/igcse_tutor.db

# ===== Pearson paper extraction =====
# Directory containing the Pearson IGCSE exam PDFs (for scripts/extract_pearson.py).
PEARSON_PAPERS_DIR=C:\Users\you\Downloads\pearson papers

# ===== Email notifications (optional) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=you@example.com
SENDER_PASSWORD=your-app-specific-password

# ===== SMS notifications (optional, requires `twilio`) =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ===== Background scheduler =====
# Set to true to run daily/weekly notification jobs (requires apscheduler + SMTP).
ENABLE_NOTIFICATION_SCHEDULER=false
